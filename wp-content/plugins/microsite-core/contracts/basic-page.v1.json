{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "BasicPageDraft",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "content",
        "appearance"
    ],
    "properties": {
        "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "heading",
                "description"
            ],
            "properties": {
                "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[^<>\\x00-\\x1F\\x7F]*$",
                    "default": "A new beginning"
                },
                "description": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$",
                    "default": ""
                }
            }
        },
        "appearance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "accent"
            ],
            "properties": {
                "accent": {
                    "type": "string",
                    "enum": [
                        "sage",
                        "rose",
                        "ocean"
                    ],
                    "default": "sage"
                }
            }
        }
    }
}

    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "@playwright/test": "1.64.1"
  }
